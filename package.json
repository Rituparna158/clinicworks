{
  "name": "clinicworks",
  "version": "1.0.0",
  "description": "Clinical Document Processing Platform built on Azure, Node.js, TypeScript, Google Gemini, and PostgreSQL",
  "main": "dist/webapp/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "start": "node dist/webapp/server.js",
    "dev": "tsx watch src/webapp/server.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "azure",
    "gemini",
    "clinical-document-processing",
    "postgresql",
    "azure-functions",
    "logic-apps",
    "typescript"
  ],
  "author": "ClinicWorks Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
