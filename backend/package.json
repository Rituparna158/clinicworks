{
  "name": "@clinicworks/backend",
  "version": "1.0.0",
  "description": "Backend services, Azure Function HTTP controllers, Gemini AI pipeline, and clinical rules engine for ClinicWorks",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:docs": "tsx src/utils/generateSampleDocs.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@azure-rest/ai-document-intelligence": "^1.0.0-beta.3",
    "@azure/core-auth": "^1.9.0",
    "@azure/storage-blob": "^12.33.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
